    "tail": 1.5,
    "cage": { "beats": [0.4, 2.0, 3.6], "cell": 120, "telegraph": 0.9 },
    "wall": { "beats": [0.4, 4.2], "speed": 230, "gapPlayerWidths": 4, "telegraph": 1.0 },
    "swarm": { "beats": [0.4, 3.0], "count": 3, "speedMul": 1.1, "life": 5 }
  },
  "juice": {
    "nearMissPlayerWidths": 0.3,
    "nearMissCooldown": 0.6,
    "hitstopMs": 120
  },
