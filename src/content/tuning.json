    "duration": 3.0,
    "warn": 0.9,
    "grace": 0.6,
    "eatBase": 25,
    "eatMax": 400,
    "grazeCharge": 1
  },
  "setPieces": {
    "$comment": "Every `every` levels an authored wave replaces random spawns, cycling cage -> wall -> swarm. beats = seconds after level-up at which each pulse fires; tail = extra quiet seconds after the last beat.",
