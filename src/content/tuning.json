    "table": [
      { "budget": 4,  "interval": 1.30, "speed": 1.00, "kinds": { "static": 1 } },
      { "budget": 6,  "interval": 1.15, "speed": 1.00, "kinds": { "static": 1, "slider": 1.4 } },
      { "budget": 8,  "interval": 1.05, "speed": 1.00, "kinds": { "static": 0.8, "slider": 1.2, "bouncer": 1.2 } },
      { "budget": 9,  "interval": 1.00, "speed": 1.04, "kinds": { "static": 0.6, "slider": 1.0, "bouncer": 1.0, "rotor": 1.2 } },
      { "budget": 10, "interval": 0.95, "speed": 1.08, "kinds": { "static": 0.5, "slider": 1.0, "bouncer": 1.0, "rotor": 0.9, "seeker": 1.0 } },
      { "budget": 11, "interval": 0.90, "speed": 1.12, "kinds": { "static": 0.5, "slider": 1.0, "bouncer": 0.9, "rotor": 0.8, "seeker": 0.8, "laser": 1.0 } }
